# Shen backend the desktop app talks to. Vite (dev) and the Electron static
# server (production) proxy /api to this origin, so the renderer stays
# same-origin and the session cookie remains first-party.
SHEN_API_URL=https://shen.zagan.space

# Live status tab (Status). The packaged app reads metrics from the hosted
# backend's public /api/metrics route, so desktop users never need a Northflank
# key. These local values are only a development fallback for that endpoint.
NORTHFLANK_API_TOKEN=
NORTHFLANK_PROJECT_ID=default
NORTHFLANK_SERVICE_ID=shen-backend

# Optional overrides for the public feedback project. Publishable keys are safe
# to embed in the client; the table is insert-only through RLS.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
